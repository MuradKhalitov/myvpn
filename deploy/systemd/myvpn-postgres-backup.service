[Unit]
Description=MyVPN PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=myvpn-deploy
Group=myvpn-deploy
WorkingDirectory=/opt/myvpn/myvpn
ExecStart=/opt/myvpn/myvpn/scripts/server/backup-postgres.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=30min
