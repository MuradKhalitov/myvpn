# Copy to .env.server and replace placeholders before deployment.
MYVPN_IMAGE=muradkhalitov/myvpn:replace-with-immutable-tag
POSTGRES_DB=myvpn
POSTGRES_USER=myvpn
POSTGRES_PASSWORD=replace-with-a-long-random-password
SPRING_PROFILES_ACTIVE=prod
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_ADMIN_IDS=replace-me
PAYMENT_PROVIDER=YOOKASSA
PAYMENT_ALLOW_FAKE=false
PAYMENT_ACTIVATION_ENABLED=true
PAYMENT_RETURN_URL=https://replace-with-public-static-page
YOOKASSA_BASE_URL=https://api.yookassa.ru/v3
YOOKASSA_SHOP_ID=replace-me
YOOKASSA_SECRET_KEY=replace-me
YOOKASSA_RETURN_URL=https://replace-with-public-static-page
YOOKASSA_WEBHOOK_ENABLED=false
YOOKASSA_CONNECT_TIMEOUT=3s
YOOKASSA_READ_TIMEOUT=10s
VPN_PROVIDER_TYPE=3x-ui
VPN_PROVIDER_ALLOW_FAKE=false
VPN_DELIVERY_ENABLED=true
THREEXUI_BASE_URL=https://replace-me
THREEXUI_WEB_BASE_PATH=/
THREEXUI_USERNAME=replace-me
THREEXUI_PASSWORD=replace-me
THREEXUI_INBOUND_ID=replace-me
THREEXUI_PUBLIC_HOST=replace-me
THREEXUI_PUBLIC_PORT_OVERRIDE=replace-me
THREEXUI_CONNECT_TIMEOUT=5s
THREEXUI_READ_TIMEOUT=10s
THREEXUI_MAX_MUTATION_ATTEMPTS=3
THREEXUI_MAX_REQUESTS_PER_OPERATION=8
THREEXUI_RETRY_INITIAL_DELAY=1s
THREEXUI_RETRY_MAX_DELAY=8s
