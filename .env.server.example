# Copy to .env.server and replace every placeholder before deployment.
POSTGRES_DB=myvpn
POSTGRES_USER=myvpn
POSTGRES_PASSWORD=replace_with_a_long_random_password

SPRING_PROFILES_ACTIVE=prod

TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
TELEGRAM_ADMIN_IDS=123456789

PAYMENT_PROVIDER=YOOKASSA
PAYMENT_ALLOW_FAKE=false
PAYMENT_ACTIVATION_ENABLED=true

VPN_PROVIDER_TYPE=3x-ui
VPN_PROVIDER_ALLOW_FAKE=false
VPN_DELIVERY_ENABLED=true

THREEXUI_BASE_URL=https://3x-ui.example.invalid
THREEXUI_WEB_BASE_PATH=/replace-with-panel-path
THREEXUI_USERNAME=replace_with_username
THREEXUI_PASSWORD=replace_with_password
THREEXUI_INBOUND_ID=1
THREEXUI_PUBLIC_HOST=vpn.example.invalid
THREEXUI_PUBLIC_PORT_OVERRIDE=
THREEXUI_CONNECT_TIMEOUT=5s
THREEXUI_READ_TIMEOUT=10s
THREEXUI_MAX_MUTATION_ATTEMPTS=3
THREEXUI_MAX_REQUESTS_PER_OPERATION=8
THREEXUI_RETRY_INITIAL_DELAY=1s
THREEXUI_RETRY_MAX_DELAY=8s
